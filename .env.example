# Copy to .env and fill in, or let `uv run quickstart` populate it for you.
# quickstart reads/writes these keys idempotently — rerunning preserves values.

# Databricks auth (profile-based; matches the CLI/SDK default resolution).
DATABRICKS_CONFIG_PROFILE=mlflow-workshop
DATABRICKS_HOST=https://<your-workspace-here>.cloud.databricks.com

# UC-managed MLflow experiment (provisioned by quickstart).
MLFLOW_EXPERIMENT_NAME=/Workspace/Shared/genie-eval-traces
MLFLOW_EXPERIMENT_ID=

# Unity Catalog trace location for the experiment.
UC_CATALOG=main
UC_SCHEMA=genie_traces
UC_TABLE_PREFIX=evals

# SQL warehouse used for MLflow trace queries and schema DDL.
MLFLOW_TRACING_SQL_WAREHOUSE_ID=

# Genie space the app traces and analyzes (set by `uv run create-genie-space`).
GENIE_SPACE_ID=

# Foundation Model endpoints.
JUDGE_MODEL=databricks-claude-sonnet-5
ANALYZER_MODEL=databricks-claude-sonnet-4-6

MLFLOW_TRACKING_URI=databricks
MLFLOW_REGISTRY_URI=databricks-uc
